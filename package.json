{
  "name": "feedback-tool",
  "version": "0.1.0",
  "description": "Framework-free in-browser screenshot annotation and feedback widget",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/feedback-tool.iife.js",
  "module": "./dist/feedback-tool.es.js",
  "exports": {
    ".": {
      "import": "./dist/feedback-tool.es.js",
      "default": "./dist/feedback-tool.iife.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:demo": "vite build --config vite.demo.config.js",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "fabric": "^7.4.0",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "jsdom": "^26.1.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
