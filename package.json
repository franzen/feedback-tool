{
  "name": "@franzen/feedback-tool",
  "version": "0.3.0",
  "description": "Framework-free in-browser screenshot annotation and feedback widget",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "feedback",
    "screenshot",
    "annotation",
    "browser-widget"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franzen/feedback-tool.git"
  },
  "bugs": {
    "url": "https://github.com/franzen/feedback-tool/issues"
  },
  "homepage": "https://github.com/franzen/feedback-tool#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "types",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:demo": "vite build --config vite.demo.config.js",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "npm run build:lib && changeset publish",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:types": "tsc -p tests/package-consumer/tsconfig.json",
    "test:package": "npm run build:lib && npm run test:types && node tests/package-consumer/import.mjs && node scripts/verify-package.mjs",
    "prepack": "npm run build:lib"
  },
  "dependencies": {
    "fabric": "^7.4.0",
    "html2canvas-pro": "^2.3.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@playwright/test": "^1.54.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
}
